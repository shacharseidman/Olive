{
  "input_model": {
    "type": "PyTorchModel",
    "model_path": "examples/resnet/models/resnet_trained_for_cifar10.pt",
    "io_config": {
        "input_names": [ "input" ],
        "input_shapes": [ [ 1, 3, 32, 32 ] ],
        "output_names": [ "output" ],
        "dynamic_axes": { "input": { "0": "batch_size" }, "output": { "0": "batch_size" } }
    }
  },
  "systems": {
    "local_system": {
      "type": "LocalSystem",
      "config": {}
    }
  },
  "data_configs": [
    {
      "name": "cifar10_data_config",
      "user_script": "examples/resnet/user_script.py",
      "load_dataset_config": { "type": "cifar10_val_dataset", "data_dir": "examples/resnet/data" },
      "dataloader_config": { "batch_size": 16, "drop_last": true }
    }
  ],
  "passes": {
    "slip": {
      "type": "SLIPOptimizer",
      "model_partitions_configurations_file": "examples/resnet/slip_partition_config.json",
      "data_config": "cifar10_data_config",
      "exposed_model_evaluator": {
        "metrics": [
          {
            "name": "accuracy",
            "type": "custom",
            "sub_types": [
              {
                "name": "accuracy_custom",
                "priority": 1,
                "higher_is_better": false,
                "goal": { "type": "max-degradation", "value": 0.1 }
              }
            ],
            "user_config": {
              "user_script": "examples/resnet/user_script.py",
              "evaluate_func": "eval_accuracy",
              "evaluate_func_kwargs": { "data_dir": "examples/resnet/data", "batch_size": 1 }
            }
          }
        ]
      },
      "exposed_model_evaluator_system": {
        "type": "LocalSystem",
        "config": {}
      }
    }
  },
  "host": "local_system",
  "target": "local_system",
  "cache_dir": "examples/resnet/cache",
  "output_dir": "models/resnet_slip"
}
